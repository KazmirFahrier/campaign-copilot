# Phase 1 onward. No key is required to build the warehouse or run the test suite.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
CC_LLM_PROVIDER=anthropic
CC_MAX_LIMIT=10000

# Production only. Without CC_EXECUTOR_URL, python_exec runs in-process and is not a security
# boundary. Without CC_EXECUTOR_AUDIENCE, Cloud Run's invoker binding rejects every call to it.
CC_EXECUTOR_URL=
CC_EXECUTOR_AUDIENCE=

# Override where the package finds its data. Unset in normal use: the wheel carries both.
CC_METRICS_PATH=
CC_PROMPTS_DIR=
CC_WAREHOUSE=
