// Gold SQL is hand-written against the mart, deliberately NOT compiled by the semantic
// layer. If both sides used build_query(), a bug in the layer would be gold.
{"id": "s01", "question": "What was total spend across all channels?", "category": "simple", "metrics": ["spend"], "dimensions": [], "gold_tools": ["query_metrics"], "gold_sql": "select sum(spend_usd) as spend from main_marts.campaign_performance_daily"}
{"id": "s02", "question": "What was total revenue?", "category": "simple", "metrics": ["revenue"], "dimensions": [], "gold_tools": ["query_metrics"], "gold_sql": "select sum(revenue_usd) as revenue from main_marts.campaign_performance_daily"}
{"id": "s03", "question": "How many clicks did we get in total?", "category": "simple", "metrics": [], "dimensions": [], "gold_tools": ["run_sql"], "gold_sql": "select sum(clicks) as clicks from main_marts.campaign_performance_daily", "notes": "clicks is not a registered metric; the agent must recognise this and use run_sql or refuse"}
{"id": "s04", "question": "Break spend down by channel.", "category": "simple", "metrics": ["spend"], "dimensions": ["channel"], "order_by": "spend", "gold_tools": ["query_metrics"], "gold_sql": "select channel, sum(spend_usd) as spend from main_marts.campaign_performance_daily group by 1 order by 2 desc"}
{"id": "s05", "question": "What is CTR by channel?", "category": "simple", "metrics": ["ctr"], "dimensions": ["channel"], "gold_tools": ["query_metrics"], "gold_sql": "select channel, sum(clicks) / nullif(sum(impressions), 0) as ctr from main_marts.campaign_performance_daily group by 1"}
{"id": "s06", "question": "What is CPC by channel?", "category": "simple", "metrics": ["cpc"], "dimensions": ["channel"], "gold_tools": ["query_metrics"], "gold_sql": "select channel, sum(spend_usd) / nullif(sum(clicks), 0) as cpc from main_marts.campaign_performance_daily group by 1"}
{"id": "s07", "question": "What is the average order value by campaign?", "category": "simple", "metrics": ["aov"], "dimensions": ["campaign_name"], "gold_tools": ["query_metrics"], "gold_sql": "select campaign_name, sum(revenue_usd) / nullif(sum(transactions), 0) as aov from main_marts.campaign_performance_daily group by 1"}
{"id": "s08", "question": "Show me spend by campaign, excluding direct traffic.", "category": "simple", "metrics": ["spend"], "dimensions": ["campaign_name"], "filters": ["campaign_name <> '(direct)'"], "gold_tools": ["query_metrics"], "gold_sql": "select campaign_name, sum(spend_usd) as spend from main_marts.campaign_performance_daily where campaign_name <> '(direct)' group by 1"}
{"id": "s09", "question": "What is conversion rate by channel?", "category": "simple", "metrics": ["cvr"], "dimensions": ["channel"], "gold_tools": ["query_metrics"], "gold_sql": "select channel, sum(transactions) / nullif(sum(sessions), 0) as cvr from main_marts.campaign_performance_daily group by 1", "notes": "cvr is per SESSION, not per click. The independently written gold disagreed with the layer; the layer is authoritative and the gold was wrong."}
{"id": "s10", "question": "What was ROAS for the always_on_brand campaign?", "category": "simple", "metrics": ["roas"], "dimensions": ["campaign_name"], "filters": ["campaign_name = 'always_on_brand'"], "gold_tools": ["query_metrics"], "gold_sql": "select campaign_name, sum(revenue_usd) / nullif(sum(spend_usd), 0) as roas from main_marts.campaign_performance_daily where campaign_name = 'always_on_brand' group by 1"}
{"id": "s11", "question": "What is cost per acquisition by campaign, ignoring direct?", "category": "simple", "metrics": ["cpa"], "dimensions": ["campaign_name"], "filters": ["campaign_name <> '(direct)'"], "gold_tools": ["query_metrics"], "gold_sql": "select campaign_name, sum(spend_usd) / nullif(sum(transactions), 0) as cpa from main_marts.campaign_performance_daily where campaign_name <> '(direct)' group by 1"}
{"id": "s12", "question": "How much did we spend on display?", "category": "simple", "metrics": ["spend"], "dimensions": [], "filters": ["channel = 'display'"], "gold_tools": ["query_metrics"], "gold_sql": "select sum(spend_usd) as spend from main_marts.campaign_performance_daily where channel = 'display'"}
{"id": "j01", "question": "Which channels had ROAS above 1.0?", "category": "join", "metrics": ["roas"], "dimensions": ["channel"], "having": ["roas > 1.0"], "gold_tools": ["query_metrics"], "gold_sql": "select channel, roas from (select channel, sum(revenue_usd) / nullif(sum(spend_usd), 0) as roas from main_marts.campaign_performance_daily group by 1) where roas > 1.0"}
{"id": "j02", "question": "Compare spend and revenue for each channel.", "category": "join", "metrics": ["spend", "revenue"], "dimensions": ["channel"], "gold_tools": ["query_metrics"], "gold_sql": "select channel, sum(spend_usd) as spend, sum(revenue_usd) as revenue from main_marts.campaign_performance_daily group by 1"}
{"id": "j03", "question": "Which campaign had the highest revenue, excluding direct?", "category": "join", "metrics": ["revenue"], "dimensions": ["campaign_name"], "filters": ["campaign_name <> '(direct)'"], "order_by": "revenue", "limit": 1, "gold_tools": ["query_metrics"], "gold_sql": "select campaign_name, sum(revenue_usd) as revenue from main_marts.campaign_performance_daily where campaign_name <> '(direct)' group by 1 order by 2 desc limit 1"}
{"id": "j04", "question": "Show ROAS and CPA together by channel.", "category": "join", "metrics": ["roas", "cpa"], "dimensions": ["channel"], "gold_tools": ["query_metrics"], "gold_sql": "select channel, sum(revenue_usd) / nullif(sum(spend_usd), 0) as roas, sum(spend_usd) / nullif(sum(transactions), 0) as cpa from main_marts.campaign_performance_daily group by 1"}
{"id": "j05", "question": "What is the lifetime value of customers acquired through paid social?", "category": "join", "metrics": ["lifetime_revenue"], "dimensions": [], "filters": ["acquisition_channel = 'paid_social'"], "gold_tools": ["query_metrics"], "gold_sql": "select sum(lifetime_revenue_usd) as lifetime_revenue from main_marts.customer_ltv where acquisition_channel = 'paid_social'", "notes": "routes to a second mart. Before the eval, the guardrail rejected this: sum(lifetime_revenue_usd) was not an atom of any registered metric, because the registry only described the campaign mart."}
{"id": "w01", "question": "What was total spend in the fourth quarter?", "category": "window", "metrics": ["spend"], "dimensions": [], "filters": ["event_date >= '2025-10-01'"], "gold_tools": ["query_metrics"], "gold_sql": "select sum(spend_usd) as spend from main_marts.campaign_performance_daily where event_date >= date '2025-10-01'"}
{"id": "w02", "question": "How did spend in December compare to November?", "category": "window", "metrics": [], "dimensions": [], "gold_tools": ["run_sql"], "gold_sql": "select month(event_date) as m, sum(spend_usd) as spend from main_marts.campaign_performance_daily where event_date >= date '2025-11-01' group by 1 order by 1"}
{"id": "w03", "question": "What was blended ROAS on the last day of the year?", "category": "window", "metrics": ["blended_roas"], "dimensions": ["event_date"], "filters": ["event_date = '2025-12-31'"], "gold_tools": ["query_metrics"], "gold_sql": "select event_date, sum(revenue_usd) / nullif(sum(spend_usd), 0) as blended_roas from main_marts.campaign_performance_daily where event_date = date '2025-12-31' group by 1"}
{"id": "w04", "question": "Show monthly revenue for the year.", "category": "window", "metrics": [], "dimensions": [], "gold_tools": ["run_sql"], "gold_sql": "select month(event_date) as m, sum(revenue_usd) as revenue from main_marts.campaign_performance_daily group by 1 order by 1"}
// Ambiguous: the correct behaviour is a clarifying question, not a guess.
{"id": "a01", "question": "What was our ROAS?", "category": "ambiguous", "expects_clarification": true, "gold_tools": [], "gold_sql": "select sum(revenue_usd) / nullif(sum(spend_usd), 0) as roas from main_marts.campaign_performance_daily", "notes": "blended (includes direct revenue) or campaign-level (excludes it)?"}
{"id": "a02", "question": "How is paid search doing?", "category": "ambiguous", "expects_clarification": true, "gold_tools": [], "gold_sql": "select channel, sum(revenue_usd) / nullif(sum(spend_usd), 0) as roas from main_marts.campaign_performance_daily where channel like 'paid_search%' group by 1", "notes": "brand and non-brand behave completely differently; blending them is meaningless"}
{"id": "a03", "question": "Rank the campaigns by revenue.", "category": "ambiguous", "expects_clarification": true, "gold_tools": [], "gold_sql": "select campaign_name, sum(revenue_usd) as revenue from main_marts.campaign_performance_daily group by 1 order by 2 desc", "notes": "'(direct)' is not a campaign; in or out?"}
{"id": "a04", "question": "What is our customer acquisition cost?", "category": "ambiguous", "expects_clarification": true, "gold_tools": [], "gold_sql": "select sum(spend_usd) / nullif(sum(purchasing_customers), 0) as cac from main_marts.campaign_performance_daily", "notes": "new customers only, or all purchasers?"}
