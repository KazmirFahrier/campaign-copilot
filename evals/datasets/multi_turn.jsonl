// Multi-turn conversations. `turn_sql` / `pin_on_turn` are the scripted driver's plan,
// exactly as golden cases embed the oracle's plan. Gold SQL is hand-written against the
// mart, never compiled by the semantic layer. Data spans 2025-01-01..2025-12-31 (SEED=20260709).
{"id": "mt01", "turns": ["What was spend by channel?", "Now break that out by campaign."], "tests": "pronoun resolution: 'that' refers to spend", "turn_sql": ["select channel, sum(spend_usd) as spend from main_marts.campaign_performance_daily group by 1 order by 1", "select campaign_name, sum(spend_usd) as spend from main_marts.campaign_performance_daily group by 1 order by 1"], "final_gold_sql": "select campaign_name, sum(spend_usd) as spend from main_marts.campaign_performance_daily group by 1 order by 1"}
{"id": "mt02", "turns": ["Show me ROAS excluding branded search.", "And what about CPA?"], "tests": "the brand exclusion must persist into the second turn", "expects_pinned": {"exclude_branded": "true"}, "pin_on_turn": 0, "turn_sql": ["select sum(revenue_usd) / nullif(sum(spend_usd), 0) as roas from main_marts.campaign_performance_daily where channel <> 'paid_search_brand'", "select sum(spend_usd) / nullif(sum(transactions), 0) as cpa from main_marts.campaign_performance_daily where channel <> 'paid_search_brand'"], "final_gold_sql": "select sum(spend_usd) / nullif(sum(transactions), 0) as cpa from main_marts.campaign_performance_daily where channel <> 'paid_search_brand'"}
{"id": "mt03", "turns": ["Spend for Q4 please.", "Same period, but revenue."], "tests": "date range carries over", "turn_sql": ["select sum(spend_usd) as spend from main_marts.campaign_performance_daily where event_date between date '2025-10-01' and date '2025-12-31'", "select sum(revenue_usd) as revenue from main_marts.campaign_performance_daily where event_date between date '2025-10-01' and date '2025-12-31'"], "final_gold_sql": "select sum(revenue_usd) as revenue from main_marts.campaign_performance_daily where event_date between date '2025-10-01' and date '2025-12-31'"}
{"id": "mt04", "turns": ["Rank campaigns by revenue, excluding direct.", "No, I meant by ROAS."], "tests": "correction: the metric changes, the direct exclusion does not", "turn_sql": ["select campaign_name, sum(revenue_usd) as revenue from main_marts.campaign_performance_daily where campaign_name is not null group by 1 order by 2 desc", "select campaign_name, sum(revenue_usd) / nullif(sum(spend_usd), 0) as roas from main_marts.campaign_performance_daily where campaign_name is not null group by 1 order by 2 desc"], "final_gold_sql": "select campaign_name, sum(revenue_usd) / nullif(sum(spend_usd), 0) as roas from main_marts.campaign_performance_daily where campaign_name is not null group by 1 order by 2 desc"}
{"id": "mt05", "turns": ["What is CTR by channel?", "Which one was highest?", "And its CPC?"], "tests": "three-turn reference chain", "turn_sql": ["select channel, sum(clicks) / nullif(sum(impressions), 0) as ctr from main_marts.campaign_performance_daily group by 1 order by 2 desc", "select channel, sum(clicks) / nullif(sum(impressions), 0) as ctr from main_marts.campaign_performance_daily group by 1 order by 2 desc limit 1", "select sum(spend_usd) / nullif(sum(clicks), 0) as cpc from main_marts.campaign_performance_daily where channel = (select channel from (select channel, sum(clicks) / nullif(sum(impressions), 0) as ctr from main_marts.campaign_performance_daily group by 1 order by 2 desc limit 1))"], "final_gold_sql": "select sum(spend_usd) / nullif(sum(clicks), 0) as cpc from main_marts.campaign_performance_daily where channel = (select channel from (select channel, sum(clicks) / nullif(sum(impressions), 0) as ctr from main_marts.campaign_performance_daily group by 1 order by 2 desc limit 1))"}
{"id": "mt06", "turns": ["Use last 28 days for everything from now on.", "Spend by channel.", "Revenue by channel."], "expects_pinned": {"date_range": "last 28 days"}, "pin_on_turn": 0, "tests": "a standing instruction must survive compression", "turn_sql": [null, "select channel, sum(spend_usd) as spend from main_marts.campaign_performance_daily where event_date > date '2025-12-03' group by 1 order by 1", "select channel, sum(revenue_usd) as revenue from main_marts.campaign_performance_daily where event_date > date '2025-12-03' group by 1 order by 1"], "final_gold_sql": "select channel, sum(revenue_usd) as revenue from main_marts.campaign_performance_daily where event_date > date '2025-12-03' group by 1 order by 1"}
