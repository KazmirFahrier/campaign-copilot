# The executor service. Runs untrusted, model-authored Python.
#
# It holds NOTHING: no LLM key, no database credential, no service-account token worth
# stealing. It has no egress. Arbitrary code execution inside this container buys an
# attacker a container with nothing in it, which is the entire design.
#
# The application asserts this at startup: campaign_copilot.service.executor.assert_no_secrets
# raises and the process crash-loops if any credential is visible in its environment. A
# misconfigured revision fails loudly rather than becoming quietly insecure.
ARG PYTHON_IMAGE=python:3.12-slim@sha256:57cd7c3a7a273101a6485ba99423ee568157882804b1124b4dd04266317710de
FROM ${PYTHON_IMAGE} AS build
WORKDIR /build
COPY pyproject.toml README.md requirements-build.lock requirements-executor.lock ./
COPY src ./src
COPY semantic ./semantic
COPY prompts ./prompts
COPY evals/datasets ./evals/datasets
RUN pip install --no-cache-dir --require-hashes -r requirements-build.lock \
 && pip install --no-cache-dir --prefix=/install --require-hashes -r requirements-executor.lock \
 && pip install --no-cache-dir --no-build-isolation --no-deps --prefix=/install .

FROM ${PYTHON_IMAGE}
RUN useradd --uid 10002 --create-home --shell /usr/sbin/nologin executor \
 && mkdir -p /scratch && chown executor:executor /scratch
COPY --from=build /install /usr/local
WORKDIR /scratch
USER executor

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 TMPDIR=/scratch

EXPOSE 8080
CMD ["sh", "-c", "uvicorn campaign_copilot.service.executor:create_app --factory --host 0.0.0.0 --port ${PORT:-8080}"]
