# The API service. Holds the LLM credential. Has egress. Runs no untrusted code.
ARG PYTHON_IMAGE=python:3.12-slim@sha256:57cd7c3a7a273101a6485ba99423ee568157882804b1124b4dd04266317710de
FROM ${PYTHON_IMAGE} AS build
WORKDIR /build
COPY pyproject.toml README.md requirements-build.lock requirements-production.lock ./
COPY src ./src
COPY semantic ./semantic
COPY prompts ./prompts
COPY evals/datasets ./evals/datasets
RUN pip install --no-cache-dir --require-hashes -r requirements-build.lock \
 && pip install --no-cache-dir --prefix=/install --require-hashes -r requirements-production.lock \
 && pip install --no-cache-dir --no-build-isolation --no-deps --prefix=/install .

FROM ${PYTHON_IMAGE}
# A distinct, unprivileged UID. Nothing in this image needs root.
RUN useradd --uid 10001 --create-home --shell /usr/sbin/nologin api \
 && mkdir -p /app/warehouse && chown api:api /app/warehouse
COPY --from=build /install /usr/local
# `semantic/metrics.yml` and `prompts/` are force-included into the wheel (see pyproject.toml),
# so the package resolves them from `campaign_copilot/_data/` and needs no COPY here. Before
# that, `pip install .` produced a package that could not find its own metrics and this image
# crash-looped on startup (docs/AUDIT.md, R4-1).
# The deterministic demo warehouse is built before the image, then copied read only into the
# immutable release. Production client data belongs in a managed warehouse adapter; this image
# intentionally proves the deployed path without claiming that synthetic data is BigQuery.
COPY --chown=api:api warehouse/campaign_copilot.duckdb /app/warehouse/campaign_copilot.duckdb
WORKDIR /app
USER api

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    CC_WAREHOUSE=/app/warehouse/campaign_copilot.duckdb

# CC_EXECUTOR_URL and CC_EXECUTOR_AUDIENCE must be set in production. Without the first, the
# service logs a warning and runs python_exec in-process, which is not a security boundary.
# Without the second, Cloud Run's invoker binding rejects every call to the executor.
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s \
  CMD python -c "import httpx;httpx.get('http://localhost:8080/healthz').raise_for_status()"
CMD ["sh", "-c", "uvicorn campaign_copilot.service.app:create_app --factory --host 0.0.0.0 --port ${PORT:-8080}"]
