# The API service. Holds the LLM credential. Has egress. Runs no untrusted code.
FROM python:3.12-slim AS build
WORKDIR /build
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir --prefix=/install ".[reporting]"

FROM python:3.12-slim
# A distinct, unprivileged UID. Nothing in this image needs root.
RUN useradd --uid 10001 --create-home --shell /usr/sbin/nologin api
COPY --from=build /install /usr/local
COPY --chown=api:api semantic /app/semantic
COPY --chown=api:api prompts /app/prompts
COPY --chown=api:api warehouse/campaign_copilot.duckdb /app/warehouse/campaign_copilot.duckdb
WORKDIR /app
USER api

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    CC_WAREHOUSE=/app/warehouse/campaign_copilot.duckdb

# CC_EXECUTOR_URL must be set in production. Without it the service logs a warning and runs
# python_exec in-process, which is not a security boundary. See docs/threat-model.md.
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s CMD python -c "import httpx;httpx.get('http://localhost:8080/healthz').raise_for_status()"
CMD ["sh", "-c", "uvicorn campaign_copilot.service.app:create_app --factory --host 0.0.0.0 --port ${PORT:-8080}"]
